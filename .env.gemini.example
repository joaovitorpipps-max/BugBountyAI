# Gemini AI Configuration untuk BugBountyAI

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro
GEMINI_TIMEOUT=30

# Gemini Features
ENABLE_GEMINI_ANALYSIS=true
ENABLE_GEMINI_RECOMMENDATIONS=true
ENABLE_GEMINI_EXPLOITATION=true
ENABLE_GEMINI_REPORTS=true
ENABLE_ZERO_DAY_PREDICTION=true

# AI Analysis Configuration
AI_ANALYSIS_DEPTH=detailed  # simple, detailed, comprehensive
AI_GENERATION_MODE=streaming  # sync, async, streaming
AI_CONFIDENCE_THRESHOLD=0.7
AI_CONTEXT_SIZE=2000

# Report Generation
GEMINI_REPORT_FORMAT=comprehensive  # quick, comprehensive, executive
GEMINI_REPORT_LANGUAGE=en
INCLUDE_CODE_EXAMPLES=true
INCLUDE_REMEDIATION=true
