# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/bugbountyai
DATABASE_POOL_SIZE=20

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
API_LOG_LEVEL=INFO

# Security
SECRET_KEY=your-super-secret-key-change-in-production
API_KEY=your-api-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ML Models
MODEL_CACHE_DIR=./models
ENABLE_GPU=True
MODEL_BATCH_SIZE=32

# Target Configuration
TIMEOUT=30
MAX_RETRIES=3
USER_AGENT=BugBountyAI/1.0

# Proxy Settings (Optional)
PROXY_ENABLED=False
PROXY_URL=http://proxy:8080

# Webhook Configuration
WEBHOOK_ENABLED=False
WEBHOOK_URL=https://your-webhook-url

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/bugbountyai.log
