# Environment Configuration for BugBountyAI v2

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=4
API_TIMEOUT=3600

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bugbountyai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/bugbountyai.log
LOG_FORMAT=json

# Features
ENABLE_DEEP_SCAN=true
ENABLE_AUTO_EXPLOIT=true
ENABLE_MONITORING=true
ENABLE_GRAPHQL_SCANNING=true
ENABLE_MOBILE_TESTING=true
ENABLE_CLOUD_SCANNING=true

# Scanning Configuration
DEFAULT_SCAN_TIMEOUT=1800
DEEP_SCAN_TIMEOUT=3600
CONCURRENT_SCANS=10
REQUEST_TIMEOUT=30

# Exploitation
ENABLE_AUTO_EXPLOITATION=true
EXPLOIT_TIMEOUT=300
MAX_EXPLOIT_ATTEMPTS=5

# Monitoring
MONITORING_INTERVAL=300
ALERT_RETENTION_DAYS=30
WEBHOOK_TIMEOUT=10
WEBHOOK_RETRIES=3

# Platform Integration
HACKERONE_API_URL=https://api.hackerone.com/v1
BUGCROWD_API_URL=https://api.bugcrowd.com/v4

# Reporting
REPORT_STORAGE_PATH=/reports
REPORT_RETENTION_DAYS=90
DEFAULT_REPORT_FORMAT=pdf

# ML/AI
ENABLE_GPU_ACCELERATION=false
ML_MODEL_PATH=/models
USE_TRANSFER_LEARNING=true

# Audit & Compliance
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_PATH=/var/log/bugbountyai_audit.log
COMPLIANCE_LEVEL=pci-dss

# Advanced Features
ENABLE_FUZZING=true
FUZZING_ITERATIONS=100
ENABLE_VULNERABILITY_CHAINING=true
ENABLE_ZERO_DAY_DETECTION=true
